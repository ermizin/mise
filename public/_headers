# Фото рецептов и фоны экранов лежат под постоянными именами и меняются редко.
# Без правила сервер отдавал их с max-age=0, и браузер перепроверял каждое фото
# при каждом заходе. Сутки фото берётся из кэша без запроса, затем ещё неделю
# показывается сохранённое, а новое подгружается в фоне.
/recipe-images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/bg/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Файлы сборки с хэшем в имени. Это правило сборщик vinext пишет сам, только
# когда своего public/_headers нет, поэтому здесь оно повторено.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
