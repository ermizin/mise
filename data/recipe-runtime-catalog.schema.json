{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mise runtime recipe catalog projection",
  "type": "object",
  "required": ["schemaVersion", "constraints", "coverage", "recipes", "failures"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "constraints": {
      "type": "object",
      "properties": {
        "releaseMenuTags": { "const": ["protein", "budget"] },
        "mediaRequired": { "const": "verified_local_source_image" },
        "servingMass": { "const": "estimated_not_verified_cooked_yield" },
        "cost": { "const": "relative_tier_not_rubles" }
      },
      "required": ["releaseMenuTags", "mediaRequired", "servingMass", "cost"]
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "slot", "title", "macros", "timeMinutes", "menuTags", "costTier", "servingMass", "shoppingIngredients", "steps", "storage", "packing", "provenance", "visualFallback", "recipeFamily", "adapter"],
        "properties": {
          "slot": { "enum": ["breakfast", "lunch", "dinner", "snack1", "snack2"] },
          "menuTags": { "type": "array", "minItems": 1, "items": { "enum": ["protein", "budget"] } },
          "costTier": { "type": "object", "properties": { "value": { "minimum": 1, "maximum": 3 }, "basis": { "const": "relative_editorial_ingredient_complexity_not_rubles" } }, "required": ["value", "basis"] },
          "servingMass": { "type": "object", "properties": { "status": { "const": "estimated_not_verified_cooked_yield" } }, "required": ["grams", "status", "method"] },
          "shoppingIngredients": { "type": "array", "items": { "type": "object", "required": ["sourceIngredientIndex", "sourceIngredientId", "canonicalIngredientId", "nameRu", "quantityGrams"] } },
          "procedureIngredients": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "quantityPerServing": { "type": "number", "exclusiveMinimum": 0 },
                "unit": { "enum": ["g", "ml", "piece"] },
                "amountStatus": { "type": "string" }
              }
            }
          },
          "recipeFamily": { "type": "object", "required": ["id", "ingredients", "miseCalculatedNutrition", "miseInstructions"] },
          "provenance": {
            "type": "object",
            "required": ["sourceUrl", "preview"],
            "properties": {
              "preview": {
                "type": "object",
                "required": ["kind", "imageUrl", "sourceImageUrl", "catalogImageUrl", "usage", "attribution", "contentType", "sha256"],
                "properties": {
                  "kind": { "const": "source_preview" },
                  "imageUrl": { "type": "string", "pattern": "^/recipe-images/" },
                  "sourceImageUrl": { "type": "string", "format": "uri" },
                  "catalogImageUrl": { "type": "string", "format": "uri" },
                  "usage": { "const": "local-source-copy-with-attribution" },
                  "attribution": { "type": "string", "minLength": 1 },
                  "contentType": { "enum": ["image/jpeg", "image/png", "image/webp", "image/avif"] },
                  "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                }
              }
            }
          },
          "visualFallback": { "type": "object", "required": ["emoji", "reserveAspectRatio"] }
        }
      }
    }
  }
}
