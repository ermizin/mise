{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/local-d1.mjs bootstrap",
    "prebuild": "node scripts/build-recipe-runtime-catalog.mjs --output data/recipe-runtime-catalog.json --require-minimum 200 && node scripts/validate-recipe-flavour-integrity.mjs",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "recipes:import:tmpm": "node scripts/import-mealprepmanual.mjs --limit 500 --output data/mealprepmanual-candidates.json",
    "recipes:import:goodfood": "node scripts/import-goodfood.mjs --limit 100 --output data/goodfood-candidates.json",
    "recipes:images:download": "node scripts/download-recipe-images.mjs",
    "recipes:runtime:refresh": "node scripts/build-recipe-runtime-catalog.mjs --output data/recipe-runtime-catalog.json --require-minimum 200 && node scripts/validate-recipe-flavour-integrity.mjs",
    "recipes:flavour:check": "node scripts/validate-recipe-flavour-integrity.mjs",
    "recipes:enrich:instructions": "node scripts/enrich-recipe-corpus.mjs",
    "recipes:instructions:check": "node scripts/build-recipe-editorial-drafts.mjs --dry-run",
    "recipes:editorial:apply": "node scripts/apply-recipe-editorial-cards.mjs",
    "recipes:audit": "node scripts/audit-recipe-corpus.mjs",
    "recipes:audit:nutrition": "node scripts/audit-recipe-nutrition.mjs",
    "recipes:audit:release": "node scripts/audit-recipe-release.mjs",
    "recipes:audit:release:write": "node scripts/audit-recipe-release.mjs --output data/recipe-release-audit.json",
    "release:vps:package": "bash scripts/package-vps-release.sh",
    "db:generate": "drizzle-kit generate",
    "db:local:bootstrap": "node scripts/local-d1.mjs bootstrap",
    "db:local:check": "node scripts/local-d1.mjs check"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
